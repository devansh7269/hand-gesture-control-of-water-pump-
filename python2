import cv2 
import serial
import time
import numpy as np

class ColorHandControlledTurret:
    def __init__(self, arduino_port='COM3', baud_rate=9600):
        # Initialize camera
        self.cap = cv2.VideoCapture(0)
        if not self.cap.isOpened():
            print("Error: Could not open camera")
            exit()
            
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        
        # Initialize Arduino
        try:
            self.arduino = serial.Serial(arduino_port, baud_rate, timeout=1)
            time.sleep(2)
            self.arduino_connected = True
            
            # Clear any leftover data
            self.arduino.reset_input_buffer()
            
            # Wait for Arduino ready message
            start_time = time.time()
            while time.time() - start_time < 5:
                if self.arduino.in_waiting > 0:
                    line = self.arduino.readline().decode().strip()
                    print(f"Arduino: {line}")
                    if "READY" in line:
                        break
                    
            print(f"Connected to Arduino on {arduino_port}")
        except Exception as e:
            self.arduino_connected = False
            print(f"Arduino not connected: {e}. Running in simulation mode.")
        
        # Servo control
        self.current_pan_angle = 90
        self.current_tilt_angle = 90
        self.frame_center = (320, 240)
        
        # Water pump control
        self.pump_running = False
        self.last_trigger_time = 0
        self.pump_duration = 1.5  # 1.5 seconds
        
        # Mouse click detection
        self.trigger_clicked = False
        self.fire_button_pos = (500, 400)
        self.fire_button_size = (120, 50)
        
        # Hand detection parameters
        self.left_hand_color = [100, 150, 150]  # BGR for left hand (blue)
        self.right_hand_color = [150, 150, 100]  # BGR for right hand (green)
        self.color_tolerance = 40
        
        # Control parameters
        self.smoothing_factor = 0.7
        self.pan_sensitivity = 2.0
        self.tilt_sensitivity = 2.0
        
        print("Color-Based Hand Controlled Water Turret initialized!")
        print("WEAR BLUE on LEFT HAND and GREEN on RIGHT HAND")
        print("LEFT HAND (Blue) controls TILT (up/down)")
        print("RIGHT HAND (Green) controls PAN (left/right)")
        print("CLICK the RED BUTTON on screen or press SPACEBAR to FIRE WATER!")
        print("Press 'q' to quit")
        print("Press 'r' to reset servos to center")
        print("Press '+' to increase sensitivity")
        print("Press '-' to decrease sensitivity")
        print("Press 't' to test pump control")
    
    def detect_colored_hands(self, frame):
        """Detect hands based on colored markers"""
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        
        # Define color ranges for left hand (blue) and right hand (green)
        # Blue color range
        lower_blue = np.array([100, 150, 50])
        upper_blue = np.array([140, 255, 255])
        
        # Green color range  
        lower_green = np.array([40, 100, 50])
        upper_green = np.array([80, 255, 255])
        
        # Create masks
        blue_mask = cv2.inRange(hsv, lower_blue, upper_blue)
        green_mask = cv2.inRange(hsv, lower_green, upper_green)
        
        # Find contours
        blue_contours, _ = cv2.findContours(blue_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        green_contours, _ = cv2.findContours(green_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        left_hand = None
        right_hand = None
        
        # Process blue contours (left hand)
        if blue_contours:
            largest_blue = max(blue_contours, key=cv2.contourArea)
            if cv2.contourArea(largest_blue) > 500:  # Minimum area threshold
                M = cv2.moments(largest_blue)
                if M["m00"] != 0:
                    cx = int(M["m10"] / M["m00"])
                    cy = int(M["m01"] / M["m00"])
                    left_hand = (cx, cy)
                    cv2.drawContours(frame, [largest_blue], -1, (255, 0, 0), 3)
                    cv2.circle(frame, (cx, cy), 10, (255, 0, 0), -1)
        
        # Process green contours (right hand)
        if green_contours:
            largest_green = max(green_contours, key=cv2.contourArea)
            if cv2.contourArea(largest_green) > 500:  # Minimum area threshold
                M = cv2.moments(largest_green)
                if M["m00"] != 0:
                    cx = int(M["m10"] / M["m00"])
                    cy = int(M["m01"] / M["m00"])
                    right_hand = (cx, cy)
                    cv2.drawContours(frame, [largest_green], -1, (0, 255, 0), 3)
                    cv2.circle(frame, (cx, cy), 10, (0, 255, 0), -1)
        
        return left_hand, right_hand
    
    def calculate_servo_angles(self, left_hand, right_hand):
        """Calculate pan and tilt angles based on hand positions"""
        pan_angle = self.current_pan_angle
        tilt_angle = self.current_tilt_angle
        
        # Right hand controls pan (left-right movement)
        if right_hand:
            rx, ry = right_hand
            dx = (rx - self.frame_center[0]) / self.frame_center[0]
            target_pan = 90 + (dx * 45 * self.pan_sensitivity)
            pan_angle = int(self.smoothing_factor * target_pan + 
                          (1 - self.smoothing_factor) * self.current_pan_angle)
        
        # Left hand controls tilt (up-down movement)
        if left_hand:
            lx, ly = left_hand
            dy = (ly - self.frame_center[1]) / self.frame_center[1]
            target_tilt = 90 + (dy * 45 * self.tilt_sensitivity)
            tilt_angle = int(self.smoothing_factor * target_tilt + 
                           (1 - self.smoothing_factor) * self.current_tilt_angle)
        
        # Constrain angles
        pan_angle = max(0, min(180, pan_angle))
        tilt_angle = max(0, min(180, tilt_angle))
        
        return pan_angle, tilt_angle
    
    def mouse_callback(self, event, x, y, flags, param):
        """Handle mouse clicks"""
        if event == cv2.EVENT_LBUTTONDOWN:
            bx, by = self.fire_button_pos
            bw, bh = self.fire_button_size
            if bx <= x <= bx + bw and by <= y <= by + bh:
                self.trigger_clicked = True
    
    def send_servo_commands(self, pan_angle, tilt_angle):
        command = f"PAN{pan_angle:03d}TILT{tilt_angle:03d}"
        if self.arduino_connected:
            try:
                self.arduino.write((command + '\n').encode())
            except Exception as e:
                print(f"Error sending to Arduino: {e}")
        return command
    
    def send_trigger_command(self):
        """Send trigger command to start water pump"""
        current_time = time.time()
        
        # Only trigger if enough time has passed since last trigger
        if current_time - self.last_trigger_time > self.pump_duration + 0.5:
            command = "TRIGGER"
            if self.arduino_connected:
                try:
                    self.arduino.write((command + '\n').encode())
                    self.last_trigger_time = current_time
                    self.pump_running = True
                    print("*** WATER PUMP ACTIVATED FOR 1.5 SECONDS! ***")
                    
                    # Update pump status after duration
                    def update_pump_status():
                        time.sleep(self.pump_duration)
                        self.pump_running = False
                    
                    import threading
                    stop_thread = threading.Thread(target=update_pump_status)
                    stop_thread.daemon = True
                    stop_thread.start()
                    
                except Exception as e:
                    print(f"Error sending trigger: {e}")
            else:
                print("*** WATER PUMP ACTIVATED FOR 1.5 SECONDS ***")
                self.last_trigger_time = current_time
                self.pump_running = True
        else:
            print("Pump is still cooling down...")
    
    def test_pump_control(self):
        """Test pump control manually"""
        if self.arduino_connected:
            print("Testing pump control...")
            print("Sending TEST_ON")
            self.arduino.write("TEST_ON\n".encode())
            time.sleep(2)
            print("Sending TEST_OFF") 
            self.arduino.write("TEST_OFF\n".encode())
            time.sleep(1)
            print("Sending STATUS")
            self.arduino.write("STATUS\n".encode())
    
    def draw_fire_button(self, frame):
        """Draw a clickable fire button on the frame"""
        bx, by = self.fire_button_pos
        bw, bh = self.fire_button_size
        
        # Change button color based on pump state
        if self.pump_running:
            button_color = (0, 255, 0)  # Green when running
        else:
            button_color = (0, 0, 255)  # Red when ready
        
        cv2.rectangle(frame, (bx, by), (bx + bw, by + bh), button_color, -1)
        cv2.rectangle(frame, (bx, by), (bx + bw, by + bh), (255, 255, 255), 2)
        
        if self.pump_running:
            text = "FIRING..."
        else:
            text = "FIRE WATER!"
            
        text_size = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, 0.7, 2)[0]
        text_x = bx + (bw - text_size[0]) // 2
        text_y = by + (bh + text_size[1]) // 2
        cv2.putText(frame, text, (text_x, text_y), 
                   cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        
        return frame
    
    def draw_control_guides(self, frame, left_hand, right_hand):
        """Draw visual guides for hand control"""
        # Draw center crosshair
        cv2.line(frame, (self.frame_center[0]-20, self.frame_center[1]), 
                (self.frame_center[0]+20, self.frame_center[1]), (255, 255, 255), 2)
        cv2.line(frame, (self.frame_center[0], self.frame_center[1]-20), 
                (self.frame_center[0], self.frame_center[1]+20), (255, 255, 255), 2)
        cv2.circle(frame, self.frame_center, 8, (255, 255, 255), 2)
        
        # Draw hand positions and labels
        if left_hand:
            lx, ly = left_hand
            cv2.circle(frame, (lx, ly), 15, (255, 0, 0), 3)
            cv2.putText(frame, "LEFT HAND - TILT", (lx-60, ly-20), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 0), 2)
            
        if right_hand:
            rx, ry = right_hand
            cv2.circle(frame, (rx, ry), 15, (0, 255, 0), 3)
            cv2.putText(frame, "RIGHT HAND - PAN", (rx-60, ry-20), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
        
        return frame
    
    def run(self):
        """Main loop"""
        print("Starting Color-Based Hand Controlled Water Turret...")
        self.send_servo_commands(90, 90)
        
        cv2.namedWindow('Color Hand Controlled Water Turret')
        cv2.setMouseCallback('Color Hand Controlled Water Turret', self.mouse_callback)
        
        while True:
            success, frame = self.cap.read()
            if not success:
                break
            
            frame = cv2.flip(frame, 1)
            
            # Read any Arduino messages
            if self.arduino_connected and self.arduino.in_waiting > 0:
                try:
                    arduino_msg = self.arduino.readline().decode().strip()
                    if "PUMP_STOPPED" in arduino_msg:
                        self.pump_running = False
                except:
                    pass
            
            # Detect hands using color
            left_hand, right_hand = self.detect_colored_hands(frame)
            
            # Check for trigger click
            if self.trigger_clicked:
                self.send_trigger_command()
                self.trigger_clicked = False
            
            # Calculate and send servo angles
            pan_angle, tilt_angle = self.calculate_servo_angles(left_hand, right_hand)
            
            # Send commands if angles changed
            if abs(pan_angle - self.current_pan_angle) > 1 or abs(tilt_angle - self.current_tilt_angle) > 1:
                self.current_pan_angle = pan_angle
                self.current_tilt_angle = tilt_angle
                self.send_servo_commands(pan_angle, tilt_angle)
            
            # Draw control guides
            frame = self.draw_control_guides(frame, left_hand, right_hand)
            
            # Display info
            cv2.putText(frame, f"Pan: {pan_angle}° Tilt: {tilt_angle}°", (10, 30), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            
            # Pump status
            pump_status = "PUMP: FIRING" if self.pump_running else "PUMP: READY"
            pump_color = (0, 255, 0) if self.pump_running else (0, 0, 255)
            cv2.putText(frame, pump_status, (10, 60), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.7, pump_color, 2)
            
            # Sensitivity display
            cv2.putText(frame, f"Sensitivity: Pan={self.pan_sensitivity:.1f}, Tilt={self.tilt_sensitivity:.1f}", 
                       (10, 90), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
            
            # Instructions
            cv2.putText(frame, "WEAR BLUE on LEFT HAND, GREEN on RIGHT HAND", (10, 120), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
            
            status_text = []
            if left_hand:
                status_text.append("LEFT HAND (Blue): TILT CONTROL ACTIVE")
            if right_hand:
                status_text.append("RIGHT HAND (Green): PAN CONTROL ACTIVE")
            if not left_hand and not right_hand:
                status_text.append("SHOW COLORED HANDS TO CONTROL TURRET")
            
            for i, text in enumerate(status_text):
                cv2.putText(frame, text, (10, 150 + i*25), 
                           cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
            
            cv2.putText(frame, "CLICK RED BUTTON or press SPACEBAR to FIRE WATER!", (10, 450), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
            
            # Draw fire button
            frame = self.draw_fire_button(frame)
            
            cv2.imshow('Color Hand Controlled Water Turret', frame)
            
            key = cv2.waitKey(1) & 0xFF
            if key == ord('q'):
                break
            elif key == ord(' '):  # SPACEBAR
                self.send_trigger_command()
            elif key == ord('r'):  # Reset servos
                self.current_pan_angle = 90
                self.current_tilt_angle = 90
                self.send_servo_commands(90, 90)
                print("Servos reset to center")
            elif key == ord('+'):  # Increase sensitivity
                self.pan_sensitivity = min(3.0, self.pan_sensitivity + 0.1)
                self.tilt_sensitivity = min(3.0, self.tilt_sensitivity + 0.1)
                print(f"Sensitivity increased: Pan={self.pan_sensitivity:.1f}, Tilt={self.tilt_sensitivity:.1f}")
            elif key == ord('-'):  # Decrease sensitivity
                self.pan_sensitivity = max(0.5, self.pan_sensitivity - 0.1)
                self.tilt_sensitivity = max(0.5, self.tilt_sensitivity - 0.1)
                print(f"Sensitivity decreased: Pan={self.pan_sensitivity:.1f}, Tilt={self.tilt_sensitivity:.1f}")
            elif key == ord('t'):  # Test pump control
                self.test_pump_control()
        
        self.cap.release()
        cv2.destroyAllWindows()
        if self.arduino_connected:
            self.arduino.close()

# Run the turret
if __name__ == "__main__":
    turret = ColorHandControlledTurret('COM3')  # Change to your port
    turret.run()
