#include <Servo.h>

// Servo pins
const int PAN_SERVO_PIN = 9;
const int TILT_SERVO_PIN = 10;
const int PUMP_PIN = 11;

// Servo objects
Servo panServo;
Servo tiltServo;

// Current angles
int panAngle = 90;
int tiltAngle = 90;

// Pump control - INVERTED LOGIC for relays
bool pumpRunning = false;
unsigned long pumpStartTime = 0;
const unsigned long PUMP_DURATION = 1500; // 1.5 seconds

void setup() {
  // Initialize serial communication FIRST
  Serial.begin(9600);
  
  // Initialize pump pin - INVERTED LOGIC
  pinMode(PUMP_PIN, OUTPUT);
  
  // For active LOW relays: HIGH = OFF, LOW = ON
  digitalWrite(PUMP_PIN, HIGH);  // Start with pump OFF
  
  // Initialize servos
  panServo.attach(PAN_SERVO_PIN);
  tiltServo.attach(TILT_SERVO_PIN);
  
  // Move servos to center position
  panServo.write(panAngle);
  tiltServo.write(tiltAngle);
  
  // Clear any leftover serial data
  while(Serial.available() > 0) {
    Serial.read();
  }
  
  Serial.println("READY - Pump OFF (INVERTED LOGIC)");
}

void loop() {
  // Check for serial commands
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    command.trim();
    
    // Clear serial buffer to prevent overflow
    while(Serial.available() > 0) {
      Serial.read();
    }
    
    processCommand(command);
  }
  
  // Check if pump should be turned off
  if (pumpRunning) {
    if (millis() - pumpStartTime >= PUMP_DURATION) {
      // INVERTED: HIGH = OFF
      digitalWrite(PUMP_PIN, HIGH); // Turn pump OFF
      pumpRunning = false;
      Serial.println("PUMP_STOPPED");
    }
  }
}

void processCommand(String command) {
  // Pan and tilt command
  if (command.startsWith("PAN")) {
    int tiltIndex = command.indexOf("TILT");
    if (tiltIndex != -1) {
      String panStr = command.substring(3, tiltIndex);
      String tiltStr = command.substring(tiltIndex + 4);
      
      int newPan = panStr.toInt();
      int newTilt = tiltStr.toInt();
      
      // Validate angles
      if (newPan >= 0 && newPan <= 180 && newTilt >= 0 && newTilt <= 180) {
        panAngle = newPan;
        tiltAngle = newTilt;
        
        panServo.write(panAngle);
        tiltServo.write(tiltAngle);
      }
    }
  }
  // Trigger command - INVERTED LOGIC
  else if (command == "TRIGGER") {
    if (!pumpRunning) {
      // INVERTED: LOW = ON (for active LOW relays)
      digitalWrite(PUMP_PIN, LOW); // Turn pump ON
      pumpRunning = true;
      pumpStartTime = millis();
      Serial.println("PUMP_STARTED");
    }
  }
  // Emergency stop and reset
  else if (command == "STOP") {
    // INVERTED: HIGH = OFF
    digitalWrite(PUMP_PIN, HIGH);
    pumpRunning = false;
    Serial.println("PUMP_FORCE_STOPPED");
  }
  // Test command to check if Arduino is responding
  else if (command == "PING") {
    Serial.println("PONG");
  }
}
